generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for better type safety
enum BlockCategory {
  WORK
  STUDY
  PERSONAL
  EXERCISE
  BREAK
  OTHER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id                     String         @id @default(cuid())
  clerkId                String         @unique
  email                  String         @unique
  firstName              String?
  lastName               String?
  imageUrl               String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  defaultSessionDuration Int            @default(90)
  weeklyGoalHours        Int            @default(12)
  emailNotifications     Boolean        @default(true)
  sessionReminders       Boolean        @default(true)
  streakAlerts           Boolean        @default(false)
  theme                  String         @default("dark")
  timezone               String         @default("UTC")
  plannedBlocks          PlannedBlock[]
  sessions               Session[]

  @@index([clerkId])
  @@index([email])
}

model Session {
  id             String         @id @default(cuid())
  userId         String
  title          String
  startTime      DateTime       @default(now())
  endTime        DateTime?
  notes          String?

  // Planning relationship - links session to the planned block that created it
  plannedBlockId String?
  plannedBlock   PlannedBlock?  @relation(fields: [plannedBlockId], references: [id], onDelete: SetNull)

  // Categorization
  category       BlockCategory  @default(OTHER)
  tags           String[]       @default([])

  // Status
  completed      Boolean        @default(false)
  isPaused       Boolean        @default(false)
  pausedAt       DateTime?

  // Break tracking
  breakCount     Int            @default(0)
  totalBreakTime Int            @default(0)

  // Productivity metrics
  focusScore     Int?           // 0-100 self-rating

  // Metadata
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
  @@index([completed])
  @@index([userId, startTime])
  @@index([plannedBlockId])
  @@index([userId, category])
}

model PlannedBlock {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   // More detailed description

  // Time - changed from String "HH:MM" to full DateTime
  // For recurring events: time component is what matters, date is reference (e.g., 1970-01-01)
  // For one-time events: full date and time
  startTime   DateTime
  duration    Int       // Duration in minutes

  // Categorization
  category    BlockCategory @default(OTHER)
  color       String?       // Hex color for UI (e.g., "#3b82f6")
  priority    Int           @default(0) // Higher = more important
  tags        String[]      @default([])

  // Recurrence settings
  isRecurring         Boolean              @default(false)
  recurrenceFrequency RecurrenceFrequency?
  recurrenceDays      Int[]                @default([]) // For WEEKLY: [0,2,4] = Sun, Tue, Thu
  recurrenceEndDate   DateTime?            // When the recurrence pattern ends

  // One-time event specific (required when isRecurring = false)
  specificDate DateTime?

  // Day of week (0-6, Sunday=0)
  // Only populated for recurring events. For one-time events, derive from specificDate on read.
  dayOfWeek    Int?

  // Reminders
  reminderMinutes Int?  // Notify X minutes before the event

  // Status
  isActive    Boolean   @default(true)

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[] // Sessions created from this planned block

  @@index([userId])
  @@index([userId, dayOfWeek])
  @@index([userId, isActive])
  @@index([userId, category])
  @@index([specificDate])
  @@index([isRecurring])
}
